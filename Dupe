-- ============================================
-- ฟังก์ชันสร้างปุ่ม Tower แต่ละอัน
-- ============================================
local function createTowerButton(name, order)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.LayoutOrder = order
    btn.Size = UDim2.new(1, -8, 0, 38)
    btn.BackgroundColor3 = THEME.bg2
    btn.BorderSizePixel = 0
    btn.Text = "  ⚡  " .. name
    btn.TextColor3 = THEME.text
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 14
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.AutoButtonColor = false
    btn.Parent = scroll

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    local stroke = Instance.new("UIStroke")
    stroke.Color = THEME.line
    stroke.Thickness = 1
    stroke.Parent = btn

    -- Hover effect
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {
            BackgroundColor3 = THEME.bg3,
        }):Play()
        TweenService:Create(stroke, TweenInfo.new(0.15), {
            Color = THEME.accent,
        }):Play()
    end)

    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {
            BackgroundColor3 = THEME.bg2,
        }):Play()
        TweenService:Create(stroke, TweenInfo.new(0.15), {
            Color = THEME.line,
        }):Play()
    end)

    -- คลิก → เสก Tower ที่เมาส์
    btn.MouseButton1Click:Connect(function()
        local mouse = player:GetMouse()
        local pos = mouse.Hit.Position + Vector3.new(0, 2, 0)
        spawnEvent:FireServer(name, pos)

        -- Flash effect
        btn.BackgroundColor3 = THEME.accent
        task.delay(0.1, function()
            TweenService:Create(btn, TweenInfo.new(0.2), {
                BackgroundColor3 = THEME.bg2,
            }):Play()
        end)
    end)
end

-- ============================================
-- โหลดรายการ Tower จาก Server
-- ============================================
local function refreshList()
    -- ล้างปุ่มเก่า
    for _, child in ipairs(scroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    local names = listFunc:InvokeServer()

    if not names or #names == 0 then
        local l = Instance.new("TextLabel")
        l.Size = UDim2.new(1, 0, 0, 40)
        l.BackgroundTransparency = 1
        l.Text = "ไม่พบ Tower ใน Folder"
        l.TextColor3 = THEME.danger
        l.Font = Enum.Font.Gotham
        l.TextSize = 13
        l.Parent = scroll
        return
    end

    for i, name in ipairs(names) do
        createTowerButton(name, i)
    end
end

-- ============================================
-- เปิด/ปิด Hub (Animation)
-- ============================================
local isOpen = false

toggleBtn.MouseButton1Click:Connect(function()
    isOpen = not isOpen

    if isOpen then
        -- เปิด
        main.Visible = true
        main.Size = UDim2.new(0, 340, 0, 0)
        TweenService:Create(main, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 340, 0, 480),
        }):Play()
        refreshList()
    else
        -- ปิด
        local tween = TweenService:Create(main, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 340, 0, 0),
        })
        tween:Play()
        tween.Completed:Connect(function()
            main.Visible = false
        end)
    end
end)

closeBtn.MouseButton1Click:Connect(function()
    isOpen = false
    main.Visible = false
end)

-- ============================================
-- ลาก Hub (Drag จาก Title Bar)
-- ============================================
local dragging = false
local dragStart, startPos

titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = main.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)
